data = pd.read_csv('Obesity_level_prediction_dataset.csv')
order = ['Insufficient_Weight','Normal_Weight','Overweight_Level_I','Overweight_Level
_II',
                 'Obesity_Type_I','Obesity_Type_II','Obesity_Type_III']
data['obesity'] = pd.Categorical(data['NObeyesdad'], categories=order,
ordered=True)
data['Gender_M']                  = (data['Gender'] == 'Male').astype(float)
data['FamHist']   = (data['family_history_with_overweight'] == 'yes').astype(float)
data['HighCalor'] = (data['FAVC'] == 'yes').astype(float)
feats = ['Age','FCVC','NCP','CH2O','FAF','TUE','Gender_M','FamHist','HighCalor']
model = OrderedModel(data['obesity'], data[feats], distr='logit')
res = model.fit(method='bfgs', disp=False)
print(res.summary())
print('odds ratios:')
print(np.exp(res.params[:len(feats)]).sort_values().round(4))
cuts = model.transform_threshold_params(res.params[len(feats):].values)
print('cut-points:', np.round(cuts, 3))
probs = np.asarray(res.predict(data[feats].iloc[[0]])).ravel()
for level, p in zip(order, probs):
       print('%-22s %.4f' % (level, p))
pred = np.asarray(res.predict(data[feats])).argmax(1)
true = data['obesity'].cat.codes.values
print('exact accuracy       : %.4f' % (pred == true).mean())
print('within one category                   : %.4f' % (np.abs(pred - true) <= 1).mean())
