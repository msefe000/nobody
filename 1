# 6.3 File path
# File path
path <- "C:/Users/satyaban.sahoo/OneDrive - Manipal Academy of Higher Education/Documents/D Drive/Time Series Analysis/2026-27 3rd Sem MSc (BA)/Nifty 50.xlsx"
 
# 6.4 Read data
