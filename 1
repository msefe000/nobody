df <- read_excel(path)
 
# 6.5 Clean data
# Clean data
df$Date <- as.Date(df$Date)
df$Price <- as.numeric(gsub(",", "", df$Price))
df <- df %>% arrange(Date) %>% na.omit()
 
# 6.6 Create zoo series
# Create zoo series
zoo_price <- zoo(df$Price, order.by = df$Date)
 
# 6.7 Convert to ts for ARIMA
# Convert to ts for ARIMA
