Portfolio Analysis – Python Codes
1. Import Libraries
import numpy as np
import pandas as pd  
import seaborn as sns
import matplotlib.pyplot as plt
import yfinance as yf
import statsmodels.api as sm
2. Download Stock and Market Data
tickers = ["INFY.NS", "HINDUNILVR.NS", "RELIANCE.NS", "SBIN.NS"]
market_ticker = "^NSEI"
 
all_tickers = tickers+ [market_ticker]
 
prices = pd.DataFrame()
for t in all_tickers:
    prices[t] = yf.download(t, start ="2021-01-01", end="2026-08-01")["Close"].squeeze() #1D
 
prices.head()
3. Calculate Daily Returns
all_returns = prices.pct_change().dropna() #drop the first row(no prior day to compare to)
## another code - 
daily_returns = all_returns[tickers] # the 4 stocks
market_returns = all_returns[market_ticker] #nifty 50 index
 
daily_returns.head()
4. Preview Market Returns
market_returns.head()
5. Calculate Annualized Stock Returns
annual_returns = daily_returns.mean()* 252
print("Annualized expected return per stock:")
print((annual_returns*100).round(2).astype(str) + "%")
6. Calculate Nifty 50 Annualized Return
market_annual_return = market_returns.mean() * 252
print(f"Nifty 50 annualized return: {market_annual_return*100:.2f} %")
7. Calculate Equal-Weight Portfolio Return
weights = np.array([0.25,0.25,0.25,0.25]) #suare brackets means a list. Equal-2weight portfolio
 
portfolio_return = np.dot(annual_returns, weights) #multiplying to arrays -matrix
print(f"Portfolio expected return: {portfolio_return*100:.2f} %")
8. Calculate the Covariance Matrix
cov_matrix = daily_returns.cov() * 252 #annualised covariance matrix
cov_matrix
9. Calculate Portfolio Variance and Risk
# To multiple covariance use @
portfolio_variance = weights @ cov_matrix.values @ weights
portfolio_volatility = portfolio_variance ** 0.5
 
print(f"Portfolio variance: {portfolio_variance:.4f}")
print(f"Portfolio volatility (risk): {portfolio_volatility*100:.2f} %")
10. Measure Diversification Benefit
individual_vols = np.sqrt(np.diag(cov_matrix.values))
no_diversification_risk = np.dot(weights, individual_vols)
 
print(f"Portfolio risk (with diversification):  {portfolio_volatility*100:.2f} %")
print(f"Risk if no diversification benefit:     {no_diversification_risk*100:.2f} %")
print(f"Diversification benfit:                 {(no_diversification_risk-portfolio_volatility)*100:.2f} percentage points")
11. Calculate the Correlation Matrix
corr_matrix = daily_returns.corr()
corr_matrix
12. Prepare the Correlation Heatmap
# seaborn is best for heatmap
13. Plot the Correlation Heatmap
plt.figure(figsize=(6,5))
sns.heatmap(corr_matrix, annot = True, fmt= ".2f", cmap="coolwarm", vmin=-1, vmax=1,
           xticklabels=tickers, yticklabels=tickers)
plt.title("Correlation Matrix of Daily Returns")
plt.tight_layout()
plt.show()
14. Run Monte Carlo Simulation for Four Stocks
RF_rate = 0.06  #risk free rate assumption, same as the study mat
 
n_portfolios = 5000
np.random.seed(42) #so results are reproducible
 
random_weights =  np.random.dirichlet(np.ones(len(tickers)), n_portfolios) #step 2 repeated 5000 times
 
port_returns = random_weights @ annual_returns.values  #step 3 (return)
port_risks = np.sqrt(np.einsum('ij, jk, ik ->i', random_weights, cov_matrix.values, random_weights))  #step3 (risk)
port_sharpes = (port_returns - RF_rate) / port_risks   #step 4
15. Identify Maximum-Sharpe and Minimum-Risk Portfolios
max_sharpe_idx = np.argmax(port_sharpes)
min_risk_idx = np.argmin(port_risks)
 
print("Max Sharpe portfolio:")
print(f"  Weights: {dict(zip(tickers,random_weights[max_sharpe_idx].round(3)))}")
print(f"  Return: {port_returns[max_sharpe_idx]*100:.2f}%  Risk:  {port_risks[max_sharpe_idx]*100:.2f}%  Sharpe: {port_sharpes[max_sharpe_idx]:.3f}")
 
print("\nMin Risk (Minimum Variance) portfolio:")
print(f" Weights: {dict(zip(tickers,random_weights[min_risk_idx].round(3)))}")
print(f" Return: {port_returns [min_risk_idx]*100: 2f}% Risk: {port_risks[min_risk_idx] *108: .2f}%")
16. Plot the Four-Stock Efficient Frontier
plt.figure(figsize=(9, 6))
plt.scatter(port_risks*100, port_returns*100, c=port_sharpes, cmap="viridis", s=8, alpha=0.6)
plt.colorbar(label="Sharpe Ratio")
plt.scatter(port_risks[max_sharpe_idx]*100, port_returns[max_sharpe_idx] *100,
             color="gold", marker="*", s=300, edgecolor="black", label="Max Sharpe Portfolio")
plt.scatter (port_risks[min_risk_idx] *100, port_returns[min_risk_idx]*100,
              color="green", marker="*",s=300, edgecolor="black", label="Min Risk Portfolio")
plt.xlabel ("Risk (%)")
plt.ylabel("Expected Return (%) ")
plt.title(f"Efficient Frontier -- (n_portfolios) Simulated Portfolios")
plt.legend()
plt.grid(True)
plt.show()
17. Estimate Individual Stock Betas and Alphas
X = sm.add_constant(market_returns.rename("Market")) #adds the intercept term
 
betas = {}
alphas = {} #we'll use these again in section 5
 
for t in tickers:
    y = daily_returns[t]
    model = sm.OLS(y,X).fit()
    alphas[t] = model.params["const"]
    betas [t] = model.params["Market"]
 
betas = pd.Series(betas)
print("Beta of each stock (systematic risk vs. Nifty 50):")
print(betas.round(3))
    
18. Calculate Portfolio Beta
portfolio_beta = np.dot(betas.values, weights)
print(f"Portfolio beta: {portfolio_beta:.3f}")
19. Define Sharpe and Treynor Ratios
def sharpe_ratio(port_return, port_volatility, rf=RF_rate):
    return(port_return - rf) / port_volatility
 
def treynor_ratio(port_return, port_beta, rf=RF_rate):
    return(port_return - rf) / port_beta
 
sharpe = sharpe_ratio(portfolio_return, portfolio_volatility)
treynor = treynor_ratio(portfolio_return, portfolio_beta)
 
print(f"Sharpe Ratio:  {sharpe:.3f}")
print(f"Treynor Ratio:  {treynor*100:.2f} % per unit of beta")
20. Calculate CAPM Return and Jensen's Alpha
capm_predicted_return = RF_rate + portfolio_beta* (market_annual_return - RF_rate)
jensens_alpha = portfolio_return - capm_predicted_return
 
print(f"Market (Nifty 50) annualized return: {market_annual_return*100:.2f} %")
print(f"Portfolio beta:                      {portfolio_beta:.3f}")
print(f"CAPM-predicted portfolio return:     {capm_predicted_return*100:.2f} %")
print(f"Actual portfolio return:             {portfolio_return*100:.2f} %")
print(f"Jensen's Alpha:                      {jensens_alpha*100:.2f} %")
 
if jensens_alpha > 0:
    print("\n--> Positive alpha: the portfolio outperformed what CAPM predicts for its risk level.")
else:
    print("\n--> Negative alpha: the portfolio underperformed what CAPM predicts for its risk level.")
21. Summarize Annualized Alpha
alpha_summary = pd.DataFrame({
    "Beta": betas,
    "Daily Alpha": pd.Series(alphas),
})
alpha_summary["Annualised Alpha (%)"] = (
    alpha_summary["Daily Alpha"]* 252 * 100
)
alpha_summary[["Beta","Annualised Alpha (%)"]].round(3)
 

 

Extension: Monte Carlo Simulation Across All Nifty 50 Stocks
1. Get Nifty 50 Constituents
url="https://en.wikipedia.org/wiki/NIFTY_50" 
tables=pd.read_html(url,storage_options={"User-Agent": "Mozilla/5.0 Chrome/120.0"}) 
 
nifty50_table=tables[1] 
nifty50_tickers=(nifty50_table["Symbol"]+".NS").tolist() 
 
print(f"Found {len(nifty50_tickers)} Nifty 50 constituents") 
print(nifty50_tickers)
2. Download Prices for Nifty 50 Stocks
nifty50_prices = pd.DataFrame()
failed_tickers = []
 
for t in nifty50_tickers:
    try:
     nifty50_prices[t] = yf.download(t,start="2021-01-01", end="2026-08-01")['Close'].squeeze()
    except Exception:
        failed_tickers.append(t)
print(f"Downloaded {nifty50_prices.shape[1]} stocks successfully")
if failed_tickers:
    print(f"Failed to download:{failed_tickers}")
        
3. Clean the Price Data
nifty50_prices_clean = nifty50_prices.dropna(axis = 1)
dropped = set(nifty50_prices.columns) - set(nifty50_prices_clean.columns)
print(f"Stocks with complete data: {nifty50_prices_clean.shape[1]} out of {nifty50_prices.shape[1]}")
if dropped:
    print(f"Dropped (incomplete data): {sorted(dropped)}")
4. Calculate Daily Returns, Annualized Returns, and Covariance
nifty50_daily_returns = (nifty50_prices_clean/nifty50_prices_clean.shift(1) - 1).dropna()
nifty50_annual_returns = nifty50_daily_returns.mean()*252
nifty50_cov_matrix = nifty50_daily_returns.cov()* 252
 
print(f"Universe size: {len(nifty_annual_returns)} stocks")
print(f"Highest annualized return: {nifty_annual_returns.idxmax()} at {nifty_annual_returns.max()*100:.1f}%")
print(f"Lowest annualized return: {nifty_annual_returns.idxmin()} at {nifty_annual_returns.min()*100:.1f}%")
5. Simulate 30,000 Portfolios
n_assets = len(nifty_annual_returns)
n_portfolios_big = 30000
np.random.seed(42)
 
nifty50_weights = np.random.dirichlet(np.ones(n_assets), n_portfolios_big)
 
nifty50_port_returns = nifty50_weights @ nifty50_annual_returns.values  
nifty50_port_risks = np.sqrt(np.einsum('ij, jk, ik ->i', nifty50_weights, nifty50_cov_matrix.values, nifty50_weights)) 
nifty50_port_sharpes = (nifty50_port_returns - RF_rate) / nifty50_port_risks
6. Identify the Best Simulated Portfolio
nifty50_max_sharpe_idx = np.argmax(nifty50_port_sharpes)
nifty50_min_risk_idx = np.argmin(nifty50_port_risks)
 
best_weights = pd.Series(nifty50_weights[nifty50_max_sharpe_idx],index=nifty50_annual_returns.index)
top_10_holdings = best_weights.sort_values(ascending=False).head(10)
 
print ("Best simulated portfolio (highest Sharpe ratio):")
print (f" Return: (nifty50_port_returns[nifty50_max_sharpe_idx]*100: 2f]%")
print(f" Risk: (nifty50_port_risks[nifty50_max_sharpe_idx]*100:.2f)%")
print (f" Sharpe: (nifty50_port_sharpes[nifty50_max sharpe_idx]: 3f) ")
print(" \nTop 10 holdings by weight:")
print ((top_10_holdings*100). round (2). astype(str) + " %")
7. Plot the Top 10 Holdings
top_10_holdings.plot(kind="barh", figsize=(7,5), color="steelblue")
plt.xlabel("Portfolio weight")
plt.ylabel("top 10 holdings- Best Simulated Nifty 50 Portfolio")
plt.gca().invert_yaxis()
plt.tight_layout()
plt.show()
